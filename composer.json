{
    "name": "brigade/company-management",
    "description": "Boys' & Girls' Brigade Company Management System",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.0",
        "vlucas/phpdotenv": "^5.6",
        "dompdf/dompdf": "^2.0",
        "phpoffice/phpspreadsheet": "^1.29",
        "phpmailer/phpmailer": "^6.9",
        "chillerlan/php-qrcode": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\": "database/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        },
        "policy": {
            "advisories": {
                "ignore-id": [
                    "GHSA-j8qw-6jw8-r297",
                    "GHSA-f5gf-2cj8-52g2",
                    "GHSA-8hg6-c449-896m",
                    "GHSA-cx96-42px-69fm",
                    "GHSA-7x2p-4jvh-6384",
                    "GHSA-wvh6-f5jh-8gw4",
                    "CVE-2023-50262",
                    "GHSA-56gj-mvh6-rp75",
                    "GHSA-3cw5-7cxw-v5qg",
                    "GHSA-6x28-7h8c-chx4"
                ]
            }
        }
    }
}
